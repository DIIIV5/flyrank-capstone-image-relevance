{
  "name": "flyrank-capstone-image-relevance",
  "version": "1.0.0",
  "description": "Picks a library photo for an article when the match is clear, and refuses it when it is not.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DIIIV5/flyrank-capstone-image-relevance.git"
  },
  "scripts": {
    "migrate": "tsx src/scripts/migrate.ts",
    "worker": "tsx src/scripts/worker.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "annotate": "tsx src/scripts/annotate.ts",
    "seed-posts": "tsx src/scripts/seed-posts.ts",
    "match": "tsx src/scripts/match.ts",
    "serve": "tsx src/scripts/serve.ts",
    "eval": "tsx src/scripts/eval.ts",
    "eval-labels": "tsx src/scripts/eval-labels.ts",
    "reset-embed-images": "tsx src/scripts/reset-embed-images.ts",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage src/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.2.0",
    "bullmq": "^6.1.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
